# Rust
target/
**/*.rs.bk
*.pdb
# Cargo.lock is committed on purpose: this workspace ships binaries, and the
# lockfile is what pins the playwright-rs git dependency to a deliberate
# commit (ADR-0004) — without it, every build floats to upstream main HEAD
# and the CI driver cache key has nothing to hash.

# Nextest artifacts
.nextest/
target/nextest/

# Test data - NEVER commit real family media
test-data/personal/
test-data/samples/
test-data/manual/
test-data/generated/
test-data/examples/
*.personal.*
*.family.*

# Example data - Downloaded from releases, not committed
example-data/

# Build artifacts
/dist/
/build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Secrets
.env
.env.local
*.key
*.pem
credentials.json
secrets/

# OS
Thumbs.db
.DS_Store

.env

# Mutation testing output
mutants.out*/
